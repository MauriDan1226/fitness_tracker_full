# Puerto en el que escucha la API
PORT=4000

# Cadena de conexion a MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/fitness_tracker

# Clave para firmar los tokens JWT (usar una cadena larga y aleatoria en produccion)
JWT_SECRET=cambia-esta-clave-por-una-secreta

# Origen permitido para las peticiones del frontend (se admite una lista separada por comas)
CLIENT_ORIGIN=http://localhost:5173
